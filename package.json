{
    "name": "paplet",
    "version": "0.1.0",
    "description": "Local-first desktop notes with the feel of paper",
    "main": "./out/main/index.js",
    "scripts": {
        "dev": "electron-vite dev",
        "start": "electron-vite preview",
        "typecheck": "tsc --noEmit",
        "test": "vitest run",
        "build": "npm run typecheck && electron-vite build",
        "pack:win": "npm run build && electron-builder --win --dir",
        "pack:store": "npm run build && electron-builder --win appx --x64 --publish never --config.directories.output=dist/store"
    },
    "keywords": [],
    "author": "",
    "license": "ISC",
    "type": "commonjs",
    "build": {
        "appId": "local.paplet.desktop",
        "productName": "Paplet",
        "files": [
            "out/**/*",
            "build/icon.png"
        ],
        "directories": {
            "output": "dist"
        },
        "win": {
            "target": "dir",
            "icon": "build/icon.ico"
        },
        "extraResources": [
            {
                "from": "node_modules/react/LICENSE",
                "to": "licenses/react.txt"
            },
            {
                "from": "node_modules/react-dom/LICENSE",
                "to": "licenses/react-dom.txt"
            },
            {
                "from": "node_modules/scheduler/LICENSE",
                "to": "licenses/scheduler.txt"
            }
        ],
        "appx": {
            "displayName": "Paplet",
            "identityName": "ClarkModequillo.Paplet",
            "publisher": "CN=09977DFD-6865-4396-A491-9B1A1F7A7173",
            "publisherDisplayName": "Clark Modequillo",
            "backgroundColor": "transparent"
        }
    },
    "devDependencies": {
        "@types/node": "^26.6.6",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@vitejs/plugin-react": "^6.3.0",
        "electron": "^45.3.1",
        "electron-builder": "^26.18.0",
        "electron-vite": "^6.0.0",
        "react": "^19.3.1",
        "react-dom": "^19.3.1",
        "typescript": "^7.0.2",
        "vite": "^8.3.8",
        "vitest": "^5.1.0"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/Clorkies/paplet.git"
    }
}
