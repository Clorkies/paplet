{
    "name": "stickee",
    "version": "1.0.0",
    "description": "Windows paper-window feasibility prototype",
    "main": "./out/main/index.js",
    "scripts": {
        "dev": "electron-vite dev",
        "start": "electron-vite preview",
        "typecheck": "tsc --noEmit",
        "test": "vitest run",
        "build": "npm run typecheck && electron-vite build",
        "pack:win": "npm run build && electron-builder --win --dir"
    },
    "keywords": [],
    "author": "",
    "license": "ISC",
    "type": "commonjs",
    "dependencies": {
        "react": "^19.3.1",
        "react-dom": "^19.3.1"
    },
    "build": {
        "appId": "local.stickee.prototype",
        "productName": "Stickee Prototype",
        "files": [
            "out/**/*"
        ],
        "directories": {
            "output": "dist"
        },
        "win": {
            "target": "dir"
        }
    },
    "devDependencies": {
        "@types/node": "^26.6.6",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@vitejs/plugin-react": "^6.3.0",
        "electron": "^45.3.1",
        "electron-builder": "^26.18.0",
        "electron-vite": "^6.0.0",
        "typescript": "^7.0.2",
        "vite": "^8.3.8",
        "vitest": "^5.1.0"
    }
}
